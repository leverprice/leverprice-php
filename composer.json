{
    "name": "leverprice/leverprice-php",
    "description": "Server-side SDK for Leverprice price experiments",
    "type": "library",
    "keywords": [
        "leverprice",
        "pricing",
        "price experiments",
        "ab testing",
        "saas",
        "checkout",
        "stripe"
    ],
    "homepage": "https://leverprice.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Leverprice",
            "homepage": "https://leverprice.com"
        }
    ],
    "support": {
        "issues": "https://github.com/leverprice/leverprice-php/issues",
        "source": "https://github.com/leverprice/leverprice-php",
        "docs": "https://leverprice.com/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "paragonie/sodium_compat": "^1.21 || ^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "ext-sodium": "Ed25519 signature checks (bundled with PHP; required unless paragonie/sodium_compat is installed)",
        "paragonie/sodium_compat": "Pure-PHP Ed25519 when ext-sodium is not available",
        "ext-curl": "Preferred HTTP transport (falls back to PHP streams)",
        "ext-apcu": "Shares the verified config between PHP-FPM workers in memory instead of a temp file",
        "psr/simple-cache-implementation": "Pass any PSR-16 cache as the 'cache' option",
        "psr/http-client-implementation": "Pass any PSR-18 client as the 'httpClient' option"
    },
    "autoload": {
        "psr-4": {
            "Leverprice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leverprice\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
